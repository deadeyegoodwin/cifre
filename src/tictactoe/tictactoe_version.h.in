#pragma once

#include <string>
#include <sstream>
#include "cifre_version.h"
#include "common_version.h"

namespace cifre { namespace tictactoe {

#define TICTACTOE_VERSION_MAJOR @tictactoe_VERSION_MAJOR@
#define TICTACTOE_VERSION_MINOR @tictactoe_VERSION_MINOR@

std::string
VersionToString(bool show_dependent_versions = false)
{
  std::stringstream sstr;
  sstr << "tictactoe version " << TICTACTOE_VERSION_MAJOR << "." << TICTACTOE_VERSION_MINOR;
  if (show_dependent_versions) {
    sstr << ", " << cifre::VersionToString();
    sstr << ", " << common::VersionToString();
  }

  return sstr.str();
}

}} // namespace cifre::tictactoe
