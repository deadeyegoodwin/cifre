#pragma once

#include <string>
#include <sstream>
#include "common_version.h"

namespace cifre { namespace celcath {

#define CELCATH_VERSION_MAJOR @celcath_VERSION_MAJOR@
#define CELCATH_VERSION_MINOR @celcath_VERSION_MINOR@

std::string
VersionToString(bool show_dependent_versions = false)
{
  std::stringstream sstr;
  sstr << "celcath version " << CELCATH_VERSION_MAJOR << "." << CELCATH_VERSION_MINOR;
  if (show_dependent_versions) {
    sstr << ", " << common::VersionToString();
  }

  return sstr.str();
}

}} // namespace cifre::celcath
